{
  "name": "ashfall-online",
  "version": "1.0.0",
  "private": true,
  "description": "Ashfall Online \u2014 2D pixel MMO (browser) + Node.js realtime server",
  "main": "server/server.mjs",
  "scripts": {
    "start": "node server/server.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "build:itch": "python3 scripts/package-release.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
